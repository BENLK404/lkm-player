      <a href="/" class="text-lg font-bold">LKMPlayer</a>
      <p class="mt-1 text-sm text-neutral-600">
        Lecteur audio open source &middot; MIT License
      </p>
    </div>

    <p class="text-sm text-neutral-600">
      &copy; {year} LKM Player
    </p>
  </div>
</footer>
